---
// Bổ sung có ngày của trang (D1.4; plans/ben-vung/them-noi-dung.md): src/content/bo-sung/<trang>/<ngày>.md, hiện ở cuối
// nội dung, mới nhất trước. Bổ sung nằm ngoài file trang, nên thêm bổ sung không đổi mã băm của trang đã khóa.
import { getCollection, render } from 'astro:content';
import { trangCuaMuc } from '../ban-build.mjs';
import { ngayViet } from '../kiem-dinh.mjs';

// Chưa có bổ sung nào thì không gọi getCollection (Astro in cảnh báo bộ rỗng ở mọi trang)
const CO_BO_SUNG = Object.keys(import.meta.glob('/src/content/bo-sung/**/*.md')).length > 0;
const trang = trangCuaMuc(Astro.locals.starlightRoute.entry);
const ds = trang && CO_BO_SUNG
	? (await getCollection('bo-sung', (b) => b.data.trang === trang)).sort((a, b) => +b.data.ngay - +a.data.ngay)
	: [];
const muc = await Promise.all(ds.map(async (b) => ({ b, Noi: (await render(b)).Content })));
const ngay = (d: Date) => ngayViet(d.toISOString().slice(0, 10));
---

{
	muc.length > 0 && (
		<section class="pz-bo-sung" aria-labelledby="bo-sung">
			<h2 id="bo-sung">Bổ sung</h2>
			{muc.map(({ b, Noi }) => (
				<article class="pz-bo-sung__muc">
					<p class="pz-bo-sung__ngay">
						<time datetime={b.data.ngay.toISOString().slice(0, 10)}>{ngay(b.data.ngay)}</time>
					</p>
					<Noi />
				</article>
			))}
		</section>
	)
}
